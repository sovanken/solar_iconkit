# Files excluded from pub.dev uploads (in addition to .gitignore).
# Assets and lib/ are intentionally NOT ignored — they ship with the package.

# Dev/tooling — maintainer-only regeneration script. Kept in git for
# contributors but not shipped in the published archive; consumers of the
# package have no use for it.
tool/
.venv/

# Screenshot capture machinery — only the PNGs referenced by pubspec.yaml
# should ship. Playwright, its node_modules, and the capture script are
# maintainer-only.
screenshots/capture.mjs
screenshots/README.md
screenshots/package.json
screenshots/package-lock.json
screenshots/node_modules/

# IDE files
.idea/
.vscode/
*.iml

# OS clutter
.DS_Store
Thumbs.db

# Example app build output (the example ships with source but not builds)
example/build/
example/.dart_tool/
example/android/.gradle/
example/ios/Pods/
example/macos/Pods/

# Publishing artefacts
/*.tar.gz
